---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ '/feed.xml' | fullUrl }}" rel="self"/>
  <link href="{{ '/' | fullUrl }}"/>
  <updated>{{ (collections.posts[0].date if collections.posts.length else build.now) | isoDate }}</updated>
  <id>{{ '/' | fullUrl }}</id>
  <author><name>{{ site.author.name }}</name></author>
  {%- for post in collections.posts | limit(20) %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ post.url | fullUrl }}"/>
    <updated>{{ post.date | isoDate }}</updated>
    <id>{{ post.url | fullUrl }}</id>
    {%- for l in post.data.labels %}<category term="{{ l }}"/>{% endfor %}
    <summary>{{ post | excerpt(60) }}</summary>
  </entry>
  {%- endfor %}
</feed>
